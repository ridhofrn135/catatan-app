# Salin file ini jadi .env lalu isi nilainya. JANGAN commit file .env ke git.

# Port aplikasi jalan
PORT=3000

# Path file database SQLite (dibuat otomatis kalau belum ada)
DATABASE_PATH=./data/catatan.db

# Environment: development | production
NODE_ENV=development

# Password untuk melihat /status (dashboard monitoring)
STATUS_MONITOR_USER=admin
STATUS_MONITOR_PASSWORD=ganti-dengan-password-kuat
